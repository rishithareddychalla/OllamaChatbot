{
  "name": "localmind-ai",
  "version": "1.0.0",
  "description": "Production-grade local AI chat application",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "concurrently \"npm start -w backend\" \"npm start -w frontend\"",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
